{
  "name": "mimic-dice",
  "version": "0.1.0",
  "private": true,
  "description": "Mimic Dice web app scaffold ready to evolve into an Electron desktop app.",
  "main": "electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run release-notes:generate && vite build",
    "build:cloudflare": "npm run release-notes:generate && vite build",
    "preview": "vite preview",
    "release-notes:generate": "node scripts/generate-release-notes.mjs",
    "translate:default-csvs": "node scripts/generate-default-translation-sidecars.mjs",
    "cache:bestiary-images": "powershell -ExecutionPolicy Bypass -File scripts/cache-bestiary-images.ps1",
    "cache:item-images": "powershell -ExecutionPolicy Bypass -File scripts/cache-item-images.ps1",
    "electron": "electron .",
    "electron:dev": "cross-env VITE_DEV_SERVER_URL=http://localhost:5173 concurrently -k \"vite\" \"wait-on tcp:5173 && electron .\"",
    "electron:build": "npm run build && electron-builder",
    "electron:build:mac-zip": "npm run build && electron-builder --mac zip",
    "electron:build:editable-mac-zip": "npm run build && electron-builder --config electron-builder.editable.json --mac zip",
    "electron:build:portable": "npm run build && electron-builder --win portable",
    "electron:build:editable-zip": "npm run build && electron-builder --config electron-builder.editable.json --win zip"
  },
  "keywords": [
    "dice",
    "game",
    "vite",
    "electron"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=20.19.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^37.1.0",
    "electron-builder": "^26.0.12",
    "vite": "^7.0.0",
    "wait-on": "^8.0.3"
  },
  "build": {
    "appId": "com.mimicdice.app",
    "productName": "Mimic Dice",
    "compression": "store",
    "directories": {
      "output": "dist-electron",
      "buildResources": "build-resources"
    },
    "afterPack": "scripts/apply-windows-exe-icon.cjs",
    "files": [
      "dist/**/*",
      "!dist/images/bestiary/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build-resources/icon.ico",
      "signAndEditExecutable": false
    },
    "mac": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.games"
    },
    "portable": {
      "artifactName": "Mimic-Dice-portable-${version}-${arch}.exe",
      "useZip": true
    }
  },
  "dependencies": {
    "xlsx": "^0.18.5"
  }
}
